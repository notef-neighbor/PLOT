PORT=8080
HOST=0.0.0.0
# Recommended production default:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
# OpenRouter is supported through AI_API_KEY / AI_BASE_URL / AI_MODEL. Its free
# routes may log or train on prompts and are blocked by default for history data.
# For non-sensitive development fixtures only:
# AI_API_KEY=sk-or-v1-...
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=openrouter/free
# ALLOW_OPENROUTER_FREE_ROUTING=true
# Comma-separated lowercase SHA-256 hashes of long random device tokens.
RECALL_DEVICE_TOKEN_HASHES=
RATE_LIMIT_MAX=60
